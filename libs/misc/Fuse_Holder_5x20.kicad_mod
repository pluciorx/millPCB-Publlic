(module Fuse_Holder_5x20 (layer F.Cu) (tedit 68A00000)
  (descr "Fuse holder for 5x20mm glass fuse, 250V, hole spacing 20mm, through hole")
  (tags "fuse holder")
  (attr thru_hole_size 5.2)
  (attr thru_hole_tolerances -0.1)
  (fp_text reference REF** (at 0 -5.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value Fuse_Holder_5x20 (at 0 5.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -15 -5) (end -15 5) (layer F.Fab) (width 0.1))
  (fp_line (start -15 5) (end 15 5) (layer F.Fab) (width 0.1))
  (fp_line (start 15 5) (end 15 -5) (layer F.Fab) (width 0.1))
  (fp_line (start 15 -5) (end -15 -5) (layer F.Fab) (width 0.1))
  (fp_line (start -15 -5) (end -12.4 -5) (layer F.SilkS) (width 0.12))
  (fp_line (start -15 -5) (end -15 5) (layer F.SilkS) (width 0.12))
  (fp_line (start -15 5) (end -12.4 5) (layer F.SilkS) (width 0.12))
  (fp_line (start 12.4 -5) (end 15 -5) (layer F.SilkS) (width 0.12))
  (fp_line (start 15 -5) (end 15 5) (layer F.SilkS) (width 0.12))
  (fp_line (start 15 5) (end 12.4 5) (layer F.SilkS) (width 0.12))
  (fp_circle (center -10 0) (end -7.4 0) (layer F.SilkS) (width 0.12))
  (fp_circle (center 10 0) (end 12.6 0) (layer F.SilkS) (width 0.12))
  (pad 1 thru_hole circle (at -10 0) (size 5.2 5.2) (drill 5.2) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 10 0) (size 5.2 5.2) (drill 5.2) (layers *.Cu *.Mask))
)
