(module SW_SPST_6mm (layer F.Cu) (tedit 5F68FEF1)
  (descr "SPST slide switch, 6mm, 2.54mm pitch through-hole")
  (tags switch spst)
  (attr through_hole)
  (fp_text reference REF** (at 0 -4.5) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value SW_SPST_6mm (at 0 4.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -3 -2.5) (end 3 -2.5) (layer F.Fab) (width 0.12))
  (fp_line (start 3 -2.5) (end 3 2.5) (layer F.Fab) (width 0.12))
  (fp_line (start 3 2.5) (end -3 2.5) (layer F.Fab) (width 0.12))
  (fp_line (start -3 2.5) (end -3 -2.5) (layer F.Fab) (width 0.12))
  (fp_line (start -1.5 -1) (end 1.5 -1) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.5 1) (end 1.5 1) (layer F.SilkS) (width 0.12))
  (pad 1 thru_hole circle (at -1.27 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 1.27 0) (size 1.7 1.7) (drill 1.0) (layers *.Cu *.Mask))
)
