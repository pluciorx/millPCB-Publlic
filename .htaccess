# millPCB — app code must revalidate on every load so a deploy shows up
# immediately. The MCP preview server does the same for .js/.html; without
# this the host serves cached JS for days after a fix is published.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|html)$">
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
  </FilesMatch>
</IfModule>
